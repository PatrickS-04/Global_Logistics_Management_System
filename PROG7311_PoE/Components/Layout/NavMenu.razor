@rendermode InteractiveServer
@inject PROG7311_PoE.Services.AuthorizationService AuthorizationService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using PROG7311_PoE.Services

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TechMove Logistics</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Login" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>

            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Home">
                        <span class="bi bi-speedometer2" aria-hidden="true"></span> Home
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="firstInnerContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="all-contracts">
                            <span class="bi bi-shield-lock" aria-hidden="true"></span> All Contracts
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage-users">
                            <span class="bi bi-people" aria-hidden="true"></span> Manage Users
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="LogisticsManager" Context="secondInnerContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="create-service-request">
                            <span class="bi bi-plus-circle" aria-hidden="true"></span> Create Service Request
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="update-contract-status">
                            <span class="bi bi-pencil-square" aria-hidden="true"></span> Update Contract Status
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="show-active-contracts">
                            <span class="bi bi-pencil-square" aria-hidden="true"></span> View Active Contracts
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="filtered-contracts">
                            <span class="bi bi-pencil-square" aria-hidden="true"></span> Filter Contracts
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="contract-files">
                            <span class="bi bi-folder-check" aria-hidden="true"></span> View Contract Files
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Client" Context="thirdInnerContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="create-contract">
                            <span class="bi bi-file-earmark-plus" aria-hidden="true"></span> Create Contract
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="show-my-contracts">
                            <span class="bi bi-file-earmark-plus" aria-hidden="true"></span> View My Contracts
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <button type="button" class="nav-link btn btn-link text-start w-100 border-0 bg-transparent m-0" @onclick="HandleLogout">
                        <span class="bi bi-box-arrow-left" aria-hidden="true"></span> Logout
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        try
        {
            await AuthorizationService.LogUserOutAsync();

            if (AuthProvider is CustomAuthStateProvider customAuthStateProvider)
            {
                customAuthStateProvider.NotifyUserLoggedOut();
            }

            NavigationManager.NavigateTo("/Login");
        }
        catch (Exception exception)
        {
            Console.WriteLine($"Error occured while trying to log user out: {exception.Message}");
        }
    }
}