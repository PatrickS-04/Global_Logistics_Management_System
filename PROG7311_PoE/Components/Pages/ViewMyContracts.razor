@inject AuthenticationStateProvider AuthenticationStateProvider
@page "/show-my-contracts"
@inject PROG7311_PoE.Services.ContractService ContractService
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TechMove.Database.DTOs
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Client")]

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">My Contracts</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Currency</th>
                    </tr>
                </thead>

                <tbody>
                    @if (contracts == null)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 text-muted">
                                    Loading active contracts...
                                </p>
                            </td>
                        </tr>
                    }
                    else if (!contracts.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <span class="bi bi-info-circle fs-2"></span>
                                <p class="mt-2">
                                    No contracts found for your account
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contract in contracts)
                        {
                            <tr>
                                <td class="align-middle">
                                    @contract.Type
                                </td>

                                <td class="align-middle">
                                    @contract.StartDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="align-middle">
                                    @contract.EndDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="align-middle">
                                    @if (contract.ContractStatus == "Expired")
                                    {
                                        <span class="badge bg-danger">
                                            @contract.ContractStatus
                                        </span>
                                    }
                                    
                                    @if (contract.ContractStatus == "OnHold")
                                    {
                                        <span class="badge bg-warning">
                                            @contract.ContractStatus
                                        </span>
                                    }
                                    
                                    @if (contract.ContractStatus == "Active")
                                    {
                                        <span class="badge bg-success">
                                            @contract.ContractStatus
                                        </span>
                                    }

                                    @if (contract.ContractStatus == "Draft")
                                    {
                                        <span class="badge bg-primary">
                                            @contract.ContractStatus
                                        </span>
                                    }
                                </td>

                                <td class="align-middle">
                                    @contract.DefaultCurrency
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="/Home" class="btn btn-outline-secondary">
            Back to Home
        </a>
    </div>

</div>

@code {
    private List<ContractDto>? contracts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                contracts = await ContractService.ViewMyContractsAsync(userId);
            }
            else
            {
                contracts = new List<ContractDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching your contracts: {ex.Message}");
            contracts = new List<ContractDto>();
        }
    }
}