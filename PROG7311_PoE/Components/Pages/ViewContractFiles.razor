@page "/contract-files"
@inject PROG7311_PoE.Services.ContractService ContractService
@using Microsoft.AspNetCore.Authorization
@using TechMove.Database.DTOs
@inject IJSRuntime JS
@attribute [Authorize(Roles = "LogisticsManager")]

<div class="container mt-5">
    <h2 class="mb-4"><span class="bi bi-file-earmark-pdf text-danger"></span> View Contract Files</h2>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Contract ID</th>
                        <th>Client Name</th>
                        <th>File Name</th>
                        <th>Date Uploaded</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (contractFiles == null)
                    {
                        <tr><td colspan="5" class="text-center">Loading files...</td></tr>
                    }
                    else if (!contractFiles.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No documents have been uploaded yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var file in contractFiles)
                        {
                            <tr>
                                <td class="fw-bold">@file.ContractId</td>
                                <td>@file.ClientName</td>
                                <td>@file.FileName</td>
                                <td>@file.DateOfUpload</td>
                                <td class="text-center">
                                    <button class="btn btn-primary btn-sm" @onclick="() => DownloadFile(file.StoredFileName, file.FileName)">
                                        <span class="bi bi-download"></span> Download
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ContractFileDto>? contractFiles;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            contractFiles = await ContractService.ViewContractFilesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching contract files: {ex.Message}");
            contractFiles = new List<ContractFileDto>();
        }
    }

    private async Task DownloadFile(string storedFileName, string originalFileName)
    {
        string errorMessage = null;

        try
        {
            var response = await ContractService.FileDownloadAsync(storedFileName);

            if (response.IsSuccessStatusCode)
            {
                var bytesOfFile = await response.Content.ReadAsByteArrayAsync();
                var fileStream = new MemoryStream(bytesOfFile);
                using var stream = new DotNetStreamReference(stream: fileStream);
                await JS.InvokeVoidAsync("downloadFileFromStream", originalFileName, stream);
            }
            else
            {
                errorMessage = "Failed to download the contract file";
            }
        }
        catch (Exception exception)
        {
            errorMessage = $"Streaming error: {exception.Message}";
        }
    }
}