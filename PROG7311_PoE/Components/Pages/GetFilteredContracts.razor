@rendermode InteractiveServer
@page "/filtered-contracts"
@using Microsoft.AspNetCore.Authorization
@using TechMove.Database.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "LogisticsManager")]

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Filter Contracts</h2>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Start Date</label>
                    <input type="date"
                        class="form-control" @bind="startDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">End Date</label>
                    <input type="date"
                        class="form-control" @bind="endDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Status</label>
                    <select class="form-select"
                            @bind="selectedStatus">
                        <option value="">-- All Statuses --</option>
                        <option value="Draft">Draft</option>
                        <option value="Active">Active</option>
                        <option value="Expired">Expired</option>
                        <option value="OnHold">On Hold</option>
                    </select>
                </div>

            </div>

            <button class="btn btn-primary"
                    @onclick="ApplyFilter">
                Apply Filter
            </button>

            <button class="btn btn-outline-secondary ms-2"
                    @onclick="ClearFilter">
                Clear
            </button>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Client</th>
                        <th>Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Currency</th>
                    </tr>
                </thead>

                <tbody>
                    @if (contracts == null)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <p class="text-muted">
                                    Apply a filter to see contracts.
                                </p>
                            </td>
                        </tr>
                    }
                    else if (!contracts.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <span class="bi bi-info-circle fs-2"></span>
                                <p class="mt-2">
                                    No contracts found matching your filter.
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contract in contracts)
                        {
                            <tr>
                                <td class="align-middle">
                                    @contract.Client?.clientName
                                </td>

                                <td class="align-middle">
                                    @contract.GetType().Name
                                </td>

                                <td class="align-middle">
                                    @contract.startDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="align-middle">
                                    @contract.endDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="align-middle">
                                    @if (contract.contractStatus == ContractStatus.Expired)
                                    {
                                        <span class="badge bg-danger">
                                            @contract.contractStatus
                                        </span>
                                    }
                                    
                                    @if (contract.contractStatus == ContractStatus.OnHold)
                                    {
                                        <span class="badge bg-warning">
                                            @contract.contractStatus
                                        </span>
                                    }
                                    
                                    @if (contract.contractStatus == ContractStatus.Active)
                                    {
                                        <span class="badge bg-success">
                                            @contract.contractStatus
                                        </span>
                                    }

                                    @if (contract.contractStatus == ContractStatus.Draft)
                                    {
                                        <span class="badge bg-primary">
                                            @contract.contractStatus
                                        </span>
                                    }
                                </td>

                                <td class="align-middle">
                                    @contract.defaultCurrency
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>

    <div class="mt-3">
        <a href="/Home" class="btn btn-outline-secondary">
            Back to Home
        </a>
    </div>

</div>

@code {
    private List<Contract>? contracts;

    private DateTime? startDate;
    private DateTime? endDate;
    private string? selectedStatus;

    private async Task ApplyFilter()
    {
        try
        {
            var queryParams = new List<string>();

            if (startDate.HasValue)
            {
                queryParams.Add($"startDate={startDate.Value:yyyy-MM-dd}");
            }

            if (endDate.HasValue)
            {
                queryParams.Add($"endDate={endDate.Value:yyyy-MM-dd}");
            }

            if (!string.IsNullOrEmpty(selectedStatus))
            {
                queryParams.Add($"contractStatus={selectedStatus}");
            }

            var query = "api/contract/filterContracts";

            if (queryParams.Any())
            {
                query += "?" + string.Join("&", queryParams);
            }

            contracts = await Http.GetFromJsonAsync<List<Contract>>(query);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching filtered contracts: {ex.Message}");
            contracts = new List<Contract>();
        }
    }

    private void ClearFilter()
    {
        startDate = null;
        endDate = null;
        selectedStatus = null;
        contracts = null;
    }
}