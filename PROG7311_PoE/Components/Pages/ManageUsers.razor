@page "/manage-users"
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@inject HttpClient Http
@attribute [Authorize(Roles = "Admin")]

<div class="container mt-5">

    <h2 class="fw-bold text-primary mb-4">Manage Users</h2>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Create New User</h5>
        </div>

        <div class="card-body">
            <form method="post" action="/api/admin/createUser">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Role</label>
                        <select name="role" class="form-select" required>
                            <option value="">-- Select Role --</option>
                            <option value="Admin">Admin</option>
                            <option value="LogisticsManager">Logistics Manager</option>
                            <option value="Client">Client</option>
                        </select>
                    </div>

                </div>

                <button type="submit" class="btn btn-success">
                    Create User
                </button>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">All Users</h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-center">Change Role</th>
                        <th class="text-center">Delete</th>
                    </tr>
                </thead>

                <tbody>

                    @if (users == null)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <div class="spinner-border text-primary"></div>
                            </td>
                        </tr>
                    }
                    else if (!users.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="align-middle">
                                    @user.Email
                                </td>

                                <td class="align-middle">
                                    <span class="badge bg-secondary">
                                        @user.Role
                                    </span>
                                </td>

                                <td class="text-center align-middle">

                                    <form method="post" action="/api/admin/changeRole">

                                        <input type="hidden" name="userId" value="@user.Id" />

                                        <select name="newRole" class="form-select form-select-sm d-inline w-auto">
                                            <option value="Admin">Admin</option>
                                            <option value="LogisticsManager">Logistics Manager</option>
                                            <option value="Client">Client</option>
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-outline-primary ms-2">
                                            Change
                                        </button>

                                    </form>

                                </td>

                                <td class="text-center align-middle">

                                    <form method="post" action="/api/admin/deleteUser">

                                        <input type="hidden" name="userId" value="@user.Id" />

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </td>
                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>
    </div>

    <div class="mt-3">
        <a href="/Home" class="btn btn-outline-secondary">
            Back to Home
        </a>
    </div>

</div>

@code {
    [SupplyParameterFromQuery]
    public string? error { get; set; }

    private List<UserDto>? users;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<JsonElement>>("api/admin/getUsers");

            users = response?.Select(u => new UserDto
            {
                Id = u.GetProperty("id").GetString() ?? "",
                Email = u.GetProperty("email").GetString() ?? "",
                Role = u.GetProperty("role").GetString() ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
            users = new List<UserDto>();
        }
    }

    public class UserDto
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
    }
}