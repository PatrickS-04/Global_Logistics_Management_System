@page "/manage-users"
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using TechMove.Database.DTOs
@inject NavigationManager NavigationManager
@inject PROG7311_PoE.Services.AdminService AdminService
@attribute [Authorize(Roles = "Admin")]

<div class="container mt-5">

    <h2 class="fw-bold text-primary mb-4">Manage Users</h2>

    @if (listOfErrors != null && listOfErrors.Any())
    {
        <div class="alert alert-danger shadow-sm">
            <h6 class="fw-bold">An error occurred:</h6>
            <ul class="mb-0">
                @foreach (var error in listOfErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Create New User</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input @bind="newEmail" type="email" class="form-control" placeholder="email" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Password</label>
                    <input @bind="newPassword" type="password" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Role</label>
                    <select @bind="newRole" class="form-select">
                        <option value="">-- Select Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="LogisticsManager">Logistics Manager</option>
                        <option value="Client">Client</option>
                    </select>
                </div>
            </div>

            <button type="button" class="btn btn-success" @onclick="HandleCreateUser"
                disabled="@(string.IsNullOrEmpty(newEmail) || string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(newRole))">
                Create User
            </button>
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">All Users</h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-center">Change Role</th>
                        <th class="text-center">Delete Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (users == null)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 mb-0 text-muted">Loading user accounts...</p>
                            </td>
                        </tr>
                    }
                    else if (!users.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No user accounts registered.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="fw-bold">@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-info">@user.Role</span>
                                    }
                                    else if (user.Role == "LogisticsManager")
                                    {
                                        <span class="badge bg-primary">Logistics Manager</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@user.Role</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex justify-content-center">
                                        <select @bind="user.SelectedRoleChange" class="form-select form-select-sm w-auto">
                                            <option value="Admin">Admin</option>
                                            <option value="LogisticsManager">LogisticsManager</option>
                                            <option value="Client">Client</option>
                                        </select>
                                        <button type="button" class="btn btn-sm btn-outline-primary ms-2" 
                                                @onclick="() => HandleChangeRole(user.Id, user.SelectedRoleChange)">
                                            Change
                                        </button>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => HandleDeleteUser(user.Id)">
                                        <span class="bi bi-trash"></span> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="/Home" class="btn btn-outline-secondary">
            Back to Home
        </a>
    </div>

</div>

@code {
    private List<AdminUserDto>? users;
    private List<string> listOfErrors = new List<string>();

    private string newEmail = string.Empty;
    private string newPassword = string.Empty;
    private string newRole = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            listOfErrors.Clear();
            users = await AdminService.GetUsersAsync();

            foreach (var user in users)
            {
                user.SelectedRoleChange = user.Role == "Logistics Manager" ? "LogisticsManager" : user.Role;
            }
        }
        catch (Exception exception)
        {
            listOfErrors.Add($"Could not get the list of users: {exception.Message}");
            users = new List<AdminUserDto>();
        }
    }

    private async Task HandleCreateUser()
    {
        try
        {
            listOfErrors.Clear();

            var response = await AdminService.CreateUserAsync(newEmail, newPassword, newRole);

            if (response.IsSuccessStatusCode)
            {
                newEmail = string.Empty;
                newPassword = string.Empty;
                newRole = string.Empty;
                await LoadUsers();
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                listOfErrors = errors ?? new List<string> { "Error occured while validating the creation of a new user" };
            }
        }    
        catch (Exception exception)
        {
            listOfErrors.Add($"Could not create a new user: {exception.Message}");
        }
    }

    private async Task HandleChangeRole(string userId, string selectedRole)
    {
        try
        {
            listOfErrors.Clear();

            var response = await AdminService.ChangeUserRoleAsync(userId, selectedRole);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                listOfErrors = errors ?? new List<string> { "Error occured while trying to change users role" };
            }
        }
        catch (Exception exception)
        {
            listOfErrors.Add($"Could not change the role of this user: {exception.Message}");
        }
    }

    private async Task HandleDeleteUser(string userId)
    {
        try
        {
            listOfErrors.Clear();

            var response = await AdminService.DeleteUserAsync(userId);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                listOfErrors = errors ?? new List<string> { "Request to delete user waas rejected" };
            }
        }
        catch (Exception exception)
        {
            listOfErrors.Add($"Could not delete this user: {exception.Message}");
        }
    }
}