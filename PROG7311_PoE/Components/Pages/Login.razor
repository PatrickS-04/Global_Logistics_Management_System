@page "/"
@page "/Login"
@using PROG7311_PoE.Services
@inject NavigationManager NavigationManager
@inject PROG7311_PoE.Services.AuthorizationService AuthorizationService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthProvider

<div class="login-container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg" style="width: 100%; max-width: 400px; border-radius: 15px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-primary">TechMove Logistics</h3>
                <p class="text-muted">Please log in</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger shadow-sm py-2">
                    @errorMessage
                </div>
            }

            <div class="form-group mb-3">
                <label class="form-label fw-bold">Email Address</label>
                <input @bind="email" type="email" class="form-control" placeholder="email" required />
            </div>
            
            <div class="form-group mb-4">
                <label class="form-label fw-bold">Password</label>
                <input @bind="password" type="password" class="form-control" placeholder="••••••••" required />
            </div>
            
            <button type="button" class="btn btn-primary w-100 py-2 fw-bold" @onclick="HandleLogin"
                    disabled="@(string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password) || isProcessing)">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>

        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;
    private bool isProcessing = false;

    private async Task HandleLogin()
    {
        try
        {
            errorMessage = null;
            isProcessing = true;

            bool isLoginSuccessful = await AuthorizationService.LogUserInAsync(email, password);

            if (isLoginSuccessful)
            {
                if (AuthProvider is CustomAuthStateProvider customProvider)
                {
                    customProvider.NotifyUserAuthenticationStateChanged();
                }

                NavigationManager.NavigateTo("/Home");
            }
            else
            {
                errorMessage = "Access Denied: Invalid email or Password. Please try again.";
            }
        }
        catch (Exception exception)
        {
            errorMessage = $"Error while trying to log user in: {exception.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}