# Build Stage

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY . .

RUN dotnet restore "PROG7311_PoE/PROG7311_PoE.csproj"

RUN dotnet publish "PROG7311_PoE/PROG7311_PoE.csproj" -c Release -o /app/publish

# Runtime Stage

FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8081

ENTRYPOINT ["dotnet", "PROG7311_PoE.dll"]